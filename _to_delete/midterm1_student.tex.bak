\begin{questions}
%==================== PART I ====================
\fullwidth{\textbf{\large Part I --- Multiple Choice.} Circle the one best answer.}
\begingradingrange{mc}
\question[3] What happens when this code runs?
\begin{lstlisting}
int x = 0, y = 5;
if ((x != 0) && (y / x > 2)) {
    printf("A\n");
} else {
    printf("B\n");
}
\end{lstlisting}
\begin{choices}
\choice It prints \code{A}
\choice It prints \code{B}
\choice It crashes on division by zero
\choice It does not compile
\end{choices}
\question[3] How many times does this loop call \code{printf}?
\begin{lstlisting}
int i;
for (i = 10; i > 0; i -= 3) {
    printf("%d ", i);
}
\end{lstlisting}
\begin{oneparchoices}
\choice 3
\choice 4
\choice 10
\choice It never stops
\end{oneparchoices}
\question[3] The ASCII value of \code{\textquotesingle{}a\textquotesingle{}} is 97. What does this code print?
\begin{lstlisting}
char ch = 'a';
ch = ch + 2;
printf("%c %d\n", ch, ch);
\end{lstlisting}
\begin{oneparchoices}
\choice \code{a 97}
\choice \code{c 97}
\choice \code{c 99}
\choice \code{a2 99}
\end{oneparchoices}
\question[3] How many distinct values can 10 bits represent?
\begin{oneparchoices}
\choice 10
\choice 100
\choice 512
\choice 1024
\end{oneparchoices}
\question[3] What is \code{0x3A7} in binary?
\begin{choices}
\choice \code{0b0011 1010 0111}
\choice \code{0b0011 1001 0111}
\choice \code{0b0111 1010 0011}
\choice \code{0b0011 0111 1010}
\end{choices}
\question[3] In this program, where is the memory that \code{arr} points to?
\begin{lstlisting}
int main(void) {
    int n = 5;
    int *arr = malloc(sizeof(int) * n);
}
\end{lstlisting}
\begin{oneparchoices}
\choice Code
\choice Data
\choice Heap
\choice Stack
\end{oneparchoices}
\question[3] \code{ptr} is an \code{int *} that points to \code{x}. Which statement stores 20 in \code{x}?
\begin{oneparchoices}
\choice \code{ptr = 20;}
\choice \code{*ptr = 20;}
\choice \code{\&ptr = 20;}
\choice \code{ptr = \&20;}
\end{oneparchoices}
\question[3] Which call allocates room for 25 \code{int}s?
\begin{choices}
\choice \code{malloc(25)}
\choice \code{malloc(sizeof(25))}
\choice \code{malloc(sizeof(int) * 25)}
\choice \code{malloc(sizeof(int)) * 25}
\end{choices}
\question[3] Given that the ASCII value of \code{\textquotesingle{}a\textquotesingle{}} is 97 and \code{\textquotesingle{}B\textquotesingle{}} is 66. What does \code{strcmp("apple", "Banana")} return?
\begin{choices}
\choice True
\choice False
\choice 31
\choice -31
\end{choices}
\question[3] Given the code below, what is the offset of \code{y}?
\begin{lstlisting}
struct pointT {
    int x;
    char str[16];
    int y;
};
\end{lstlisting}
\begin{oneparchoices}
\choice 0
\choice 4
\choice 16
\choice 20
\end{oneparchoices}
\question[3] In a stored-program computer, where are a running program's instructions stored?
\begin{choices}
\choice In the control unit
\choice In the memory unit, alongside the program's data
\choice On the hard drive
\choice In the processing unit
\end{choices}
\question[3] Which expression is equivalent to \texttt{NOT(NOT(A) AND NOT(B))}?
\begin{oneparchoices}
\choice \texttt{A AND B}
\choice \texttt{A OR B}
\choice \texttt{NOT(A) OR NOT(B)}
\choice \texttt{NOT(A AND B)}
\end{oneparchoices}
\endgradingrange{mc}
