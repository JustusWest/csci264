\fullwidth{\textbf{\large Part II --- Short Answer.} Show your work.}
\begingradingrange{sa}
\needspace{4in}
\question[9] Convert \code{0b11010110} to hexadecimal and to decimal. Show your work.
\makeemptybox{1.5in}
\needspace{4in}
\question[9] After this code runs, what are the values of \code{x} and \code{y}, and what do \code{ptr1} and \code{ptr2} point to?
\begin{lstlisting}
int x, y;
int *ptr1, *ptr2;
x = 2;
ptr1 = &x;
ptr2 = ptr1;
*ptr2 = 5;
y = *ptr1 + x;
ptr1 = &y;
*ptr1 = *ptr2 * 3;
\end{lstlisting}
\makeemptybox{1.25in}
\needspace{4in}
\question[9] Draw a diagram of the von Neumann architecture - label the units and buses.
\makeemptybox{3in}
\needspace{4in}
\question[9] Complete the truth table for this circuit. Which single gate from class computes the same function?
\begin{center}
\begin{circuitikz}\ctikzset{logic ports=ieee}
\node[or port] (g1) at (3,1.5) {};
\node[and port] (g2) at (3,-0.5) {};
\node[not port] (g3) at (5,-0.5) {};
\node[and port] (g4) at (8,0.5) {};
\coordinate (a) at (0.9,2.3);
\coordinate (b) at (1.5,-1.3);
\draw (-0.2,2.3) node[left]{$A$} -- (a);
\draw (-0.2,-1.3) node[left]{$B$} -- (b);
\draw (a) |- (g1.in 1);
\draw (a) |- (g2.in 1);
\draw (b) |- (g1.in 2);
\draw (b) |- (g2.in 2);
\draw (a |- g1.in 1) node[circle,fill,inner sep=1.2pt]{};
\draw (b |- g2.in 2) node[circle,fill,inner sep=1.2pt]{};
\draw (g2.out) -- (g3.in 1);
\draw (g1.out) -| ([xshift=-0.4cm]g4.in 1) -- (g4.in 1);
\draw (g3.out) -| ([xshift=-0.4cm]g4.in 2) -- (g4.in 2);
\draw (g4.out) -- ++(0.5,0) node[right]{$Y$};
\end{circuitikz}
\\[8pt]\begin{tabular}{cc|c}A & B & Y\\\hline 0 & 0 & \\ 0 & 1 & \\ 1 & 0 & \\ 1 & 1 & \\\end{tabular}
\end{center}
\endgradingrange{sa}
%==================== PART III ====================
\newpage
\fullwidth{\textbf{\large Part III --- Longer Problems.} Show your work.}
\begingradingrange{long1}
\question\label{q:long1} A \emph{running sum} of an array replaces each element with the sum of it and every element before it. For \code{\{3, -1, 4, 1, 5\}}, the running sum is \code{\{3, 2, 6, 7, 12\}}.
\begin{parts}
\needspace{4.50in}
\part[14] Write the function below. It returns a new array on the heap holding the running sum of \code{arr}, and does not change \code{arr}. Return \code{NULL} if \code{malloc} fails. You may assume \code{n} is at least 1.
\begin{lstlisting}
int *running_sum(int *arr, int n);
\end{lstlisting}
\makeemptybox{3in}
\needspace{3.25in}
\part[7] Write the lines of \code{main} that declare \code{int data[5] = \{3, -1, 4, 1, 5\};}, call \code{running\_sum} on it, print the result, and clean up.
\makeemptybox{2.25in}
\needspace{2.25in}
\part[5] A classmate writes \code{int sums[100];} inside \code{running\_sum} instead of calling \code{malloc}, and returns \code{sums}. Explain why this is wrong.
\makeemptybox{1.25in}
\end{parts}
\endgradingrange{long1}
\begingradingrange{long2}
\question\label{q:long2} A store keeps its inventory in a heap array of this struct:
\begin{lstlisting}
struct itemT {
    char name[32];
    int qty;
    double price;
};
\end{lstlisting}
\begin{parts}
\needspace{3.75in}
\part[9] Write a function that returns the total value of the inventory: the sum of \code{qty * price} over all \code{n} items.
\begin{lstlisting}
double inventory_value(struct itemT *items, int n);
\end{lstlisting}
\makeemptybox{2.25in}
\needspace{4.00in}
\part[10] Write a function that returns a pointer to the item whose name matches \code{name}, or \code{NULL} if there is no such item.
\begin{lstlisting}
struct itemT *find_item(struct itemT *items, int n, char *name);
\end{lstlisting}
\makeemptybox{2.5in}
\needspace{2.75in}
\part[7] In \code{main}, \code{inv} is the array and \code{n} its length. Write code that uses \code{find\_item} to add 5 to the quantity of \code{"bolt"}, or prints a message if there is no bolt.
\makeemptybox{1.75in}
\end{parts}
\endgradingrange{long2}
\newpage
\begingradingrange{long3}
\question\label{q:long3} Use this program for all parts.
\begin{lstlisting}
int total = 0;
void update(int *arr, int n, int *big) {
    int i;
    for (i = 0; i < n; i++) {
        arr[i] = arr[i] * 2;
        total += arr[i];
        if (arr[i] > *big) {
            *big = arr[i];
        }
    }
    /* POINT A */
}
int main(void) {
    int n = 3;
    int big = 0;
    int *vals = malloc(sizeof(int) * n);
    vals[0] = 4;
    vals[1] = -1;
    vals[2] = 3;
    update(vals, n, &big);
    printf("%d %d %d\n", vals[1], big, total);
    free(vals);
    return 0;
}
\end{lstlisting}
\begin{parts}
\needspace{4.50in}
\part[14] Draw a diagram of the computer's memory at POINT A. Show the stack (with a frame for each active function), the heap, and the data region. Give every variable's value, and draw an arrow for every pointer.
\makeemptybox{3.5in}
\needspace{1.75in}
\part[5] What does the program print?
\makeemptybox{0.75in}
\needspace{2.50in}
\part[7] Suppose \code{update}'s third parameter were \code{int big} (not a pointer), with every \code{*big} changed to \code{big} and the call changed to \code{update(vals, n, big)}. What would the program print now, and why?
\makeemptybox{1.5in}
\end{parts}
\endgradingrange{long3}
\end{questions}
